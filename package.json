{
  "name": "payroll",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc -b && vite build",
    "build:tauri": "tauri build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm test:workspace-store && pnpm test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:workspace-store": "node scripts/run-payroll-workspace-store-test.mjs",
    "tauri": "tauri",
    "prepare": "simple-git-hooks",
    "version:bump": "bumpp package.json --no-commit --no-tag --no-push --execute \"node scripts/sync-tauri-version.mjs\"",
    "version:commit": "bumpp package.json --release patch --yes --no-commit --no-tag --no-push --no-verify --execute \"node scripts/sync-tauri-version.mjs\" && git add package.json pnpm-lock.yaml src-tauri/tauri.conf.json",
    "version:major": "bumpp package.json --release major --no-commit --no-tag --no-push --execute \"node scripts/sync-tauri-version.mjs\"",
    "version:minor": "bumpp package.json --release minor --no-commit --no-tag --no-push --execute \"node scripts/sync-tauri-version.mjs\"",
    "version:patch": "bumpp package.json --release patch --no-commit --no-tag --no-push --execute \"node scripts/sync-tauri-version.mjs\""
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm version:commit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "shadcn": "^4.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vconsole": "^3.15.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright-core": "^1.60.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
