{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "工资工作台",
  "version": "1.0.7",
  "identifier": "com.payroll.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420/?debug=1",
    "beforeDevCommand": "pnpm dev --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "工资工作台",
        "width": 1280,
        "height": 860,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "033d551d-4431-5825-b222-3d18171a68df",
        "language": {
          "zh-CN": {
            "localePath": "wix/zh-CN.wxl"
          }
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
